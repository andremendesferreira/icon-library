# =============================================================================
# ICON-LIBRARY — secrets and server settings
# Copy to .env and fill in. .env is ignored by git and by the Docker image.
# =============================================================================

# ── Buy me a coffee (Stripe) ───────────────────────────────────────────────
# Secret key: a restricted key is enough — permission "Checkout Sessions: Read"
STRIPE_SECRET_KEY=rk_live_xxx
# Payment Link (price about US$ 3). In the link settings, "After payment" →
# "Don't show confirmation page" → redirect to:
#   https://iconlibrary.io/?coffee={CHECKOUT_SESSION_ID}
STRIPE_PAYMENT_LINK=https://buy.stripe.com/xxx
# Optional: only payments from this link count (plink_…)
STRIPE_PAYMENT_LINK_ID=
# Price shown on the button (the real price is the one in the Payment Link)
COFFEE_PRICE=US$ 3

# ── Iconlibrary moderation ─────────────────────────────────────────────────
# Password for /admin (any user name). Without it, /admin is off.
ADMIN_PASSWORD=choose-a-long-password

# ── PostgreSQL (supporters, Iconlibrary) ───────────────────────────────────
# Tables are created by the migrations in migrations/, applied on start-up
# (or with npm run migrate). The user needs permission to create tables.
# Database on the same server, outside Docker: host.docker.internal
PG_HOST=host.docker.internal
PG_PORT=5432
PG_USER=iconlibrary
PG_PASSWORD=change-me
PG_DATABASE=iconlibrary
# true if the database requires SSL
PG_SSL=false
# false when PG_USER is an application user without CREATE permission: the
# database owner applies the migrations with npm run migrate (PG_USER=owner)
PG_MIGRATE=true
