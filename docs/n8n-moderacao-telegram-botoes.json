    {
      "id": "cbceff38-b5ff-4b81-b2e0-c82030e2edc6",
      "name": "Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        480
      ],
      "parameters": {
        "jsCode": "// Resposta do site → texto curto em resposta à foto\nconst pedido = $('Interpretar').first().json;\nconst r = $input.first().json;\nconst status = r.statusCode;\nconst erro = r.body?.error;\nlet texto;\nif (status === 200) {\n  texto = {\n    approve: '✅ Aprovado: ' + pedido.nome,\n    reject: '⛔ Recusado: ' + pedido.nome + ' — ' + String(pedido.nota).replace(/^Telegram: /, ''),\n    delete: '🗑️ Excluído: ' + pedido.nome,\n  }[pedido.acao];\n} else if (erro === 'changed') {\n  texto = '⚠️ O autor mudou \"' + pedido.nome + '\" depois desta mensagem. Nada foi feito: a versão nova chega numa mensagem nova.';\n} else if (erro === 'not_pending') {\n  texto = 'ℹ️ \"' + pedido.nome + '\" já tinha sido decidido (' + (r.body.status ?? '?') + '). Nada mudou.';\n} else if (erro === 'approved') {\n  texto = 'ℹ️ \"' + pedido.nome + '\" está aprovado: excluir só pelo /admin.';\n} else if (status === 404) {\n  texto = 'ℹ️ \"' + pedido.nome + '\" não existe mais.';\n} else {\n  texto = '❌ Erro ' + status + ' (' + (erro ?? 'sem detalhe') + ') em \"' + pedido.nome + '\". Tente pelo /admin.';\n}\nreturn [{ json: { ...pedido, texto } }];\n"
      }
    },
