    {
      "id": "fabf157a-2947-4b5b-bc44-d24d6d946bb0",
      "name": "Configuração",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        200
      ],
      "parameters": {
        "jsCode": "// Ajuste aqui (o mesmo site do fluxo de moderação).\n// telegramUserId: o SEU id no Telegram (o @userinfobot mostra). Clique de\n// qualquer outra pessoa é ignorado.\nreturn [{\n  json: {\n    site: \"https://iconlibrary.io\",\n    telegramUserId: \"\",\n  },\n}];\n"
      }
    },
    {
      "id": "a2c64d8f-9ec7-4af9-b970-75f6e1e636c5",
      "name": "Interpretar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        200
      ],
      "parameters": {
        "jsCode": "// O toque chega do painel (a mensagem com botões logo abaixo da foto):\n// \"ação|id|versão\" (versão = submittedAt em segundos)\n//   a aprova · r mostra os motivos · m|…|k recusa com o motivo k\n//   d pede confirmação · x exclui · v volta ao painel · c cancela\n// Cada passo edita o próprio painel (painelId); o nome do ícone vem da\n// legenda da foto, a que o painel responde.\nconst config = $('Configuração').first().json;\nconst q = $('Clique no botão').first().json.callback_query;\nconst msg = q.message;\nconst base = { queryId: q.id, chatId: msg.chat.id, painelId: msg.message_id };\n// O aviso mostra o id de quem tocou (só essa pessoa vê): é o número que\n// vai em telegramUserId, na Configuração\nif (!config.telegramUserId || String(q.from.id) !== String(config.telegramUserId))\n  return [{ json: { ...base, passo: 'negado', aviso: config.telegramUserId\n    ? 'Sem permissão (seu id: ' + q.from.id + ').'\n    : 'Falta o telegramUserId na Configuração. Seu id: ' + q.from.id } }];\n// Mensagens de antes do painel tinham os botões na própria foto, que o nó\n// do Telegram não consegue editar\nif (msg.photo) return [{ json: { ...base, passo: 'negado', aviso: 'Mensagem antiga: decida no /admin.' } }];\n\nconst [acao, id, t, k] = String(q.data ?? '').split('|');\nif (!/^\\d+$/.test(id ?? '')) return [{ json: { ...base, passo: 'negado', aviso: 'Botão inválido.' } }];\nconst legenda = msg.reply_to_message?.caption ?? '';\nconst nome = (legenda.split('\\n')[0].split(' — ').pop() || 'ícone #' + id).trim();\nconst MOTIVOS = {\n  marca: 'Logotipo ou marca registrada',\n  ofensivo: 'Conteúdo ofensivo',\n  nome: 'O nome não corresponde ao desenho',\n  qualidade: 'Qualidade ou desenho incompleto',\n  outro: 'Recusado na moderação',\n};\nconst comum = { ...base, id, t, nome, submittedAt: Number(t) * 1000 };\nconst passo = (p, aviso, textoPainel, extra = {}) => [{ json: { ...comum, passo: p, aviso, textoPainel, ...extra } }];\nif (acao === 'r') return passo('motivos', 'Escolha o motivo', 'Por que recusar \"' + nome + '\"?');\nif (acao === 'd') return passo('confirmar', 'Confirme a exclusão', 'Excluir \"' + nome + '\"? Não dá para desfazer.');\nif (acao === 'v') return passo('principal', 'Voltou', 'Decida sobre \"' + nome + '\":');\nif (acao === 'c') return passo('final', 'Cancelado', 'Cancelado.');\nconst decisao = { a: 'approve', m: 'reject', x: 'delete' }[acao];\nif (!decisao) return [{ json: { ...base, passo: 'negado', aviso: 'Botão inválido.' } }];\nreturn passo('decidir', 'Enviando…', '', {\n  acao: decisao,\n  nota: decisao === 'reject' ? 'Telegram: ' + (MOTIVOS[k] ?? MOTIVOS.outro) : undefined,\n});\n"
      }
    },
