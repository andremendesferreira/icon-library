    {
      "id": "cbceff38-b5ff-4b81-b2e0-c82030e2edc6",
      "name": "Resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        540
      ],
      "parameters": {
        "jsCode": "// Resposta do site → o texto final do painel. Erro inesperado devolve os\n// botões (tentar de novo); o resto encerra o painel.\nconst pedido = $('Interpretar').first().json;\nconst r = $input.first().json;\nconst status = r.statusCode;\nconst erro = r.body?.error;\nlet textoPainel;\nlet tentarDeNovo = false;\nif (status === 200) {\n  textoPainel = {\n    approve: '✅ Aprovado: ' + pedido.nome,\n    reject: '⛔ Recusado: ' + pedido.nome + ' — ' + String(pedido.nota).replace(/^Telegram: /, ''),\n    delete: '🗑️ Excluído: ' + pedido.nome,\n  }[pedido.acao];\n} else if (erro === 'changed') {\n  textoPainel = '⚠️ O autor mudou \"' + pedido.nome + '\" depois desta mensagem. Nada foi feito: a versão nova chega numa mensagem nova.';\n} else if (erro === 'not_pending') {\n  textoPainel = 'ℹ️ \"' + pedido.nome + '\" já tinha sido decidido (' + (r.body.status ?? '?') + ').';\n} else if (erro === 'approved') {\n  textoPainel = 'ℹ️ \"' + pedido.nome + '\" está aprovado: excluir só pelo /admin.';\n} else if (status === 404) {\n  textoPainel = 'ℹ️ \"' + pedido.nome + '\" não existe mais.';\n} else {\n  textoPainel = '❌ Erro ' + status + ' (' + (erro ?? 'sem detalhe') + ') em \"' + pedido.nome + '\". Tente de novo ou decida no /admin.';\n  tentarDeNovo = true;\n}\nreturn [{ json: { ...pedido, textoPainel, tentarDeNovo } }];\n"
      }
    },
