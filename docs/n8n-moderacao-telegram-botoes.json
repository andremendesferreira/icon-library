    {
      "id": "fabf157a-2947-4b5b-bc44-d24d6d946bb0",
      "name": "Configuração",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "// Ajuste aqui (o mesmo site do fluxo de moderação).\n// telegramUserId: o SEU id no Telegram (o @userinfobot mostra). Clique de\n// qualquer outra pessoa é ignorado.\nreturn [{\n  json: {\n    site: \"https://iconlibrary.io\",\n    telegramUserId: \"\",\n  },\n}];\n"
      }
    },
    {
      "id": "a2c64d8f-9ec7-4af9-b970-75f6e1e636c5",
      "name": "Interpretar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "// O botão traz \"ação|id|versão\" (versão = submittedAt em segundos):\n//   a aprovar · r pede o motivo · m|…|k recusa com o motivo k\n//   d pede confirmação · x exclui (confirmado) · c cancela\n// A mensagem com a foto é a original; motivo e confirmação chegam como\n// resposta a ela e são apagados depois.\nconst config = $('Configuração').first().json;\nconst q = $('Clique no botão').first().json.callback_query;\nconst msg = q.message;\nconst base = {\n  queryId: q.id,\n  chatId: msg.chat.id,\n  fotoId: msg.reply_to_message?.message_id ?? msg.message_id,\n  pergunta: msg.reply_to_message ? msg.message_id : null,\n};\nif (!config.telegramUserId || String(q.from.id) !== String(config.telegramUserId))\n  return [{ json: { ...base, passo: 'negado', aviso: 'Sem permissão.' } }];\n\nconst [acao, id, t, k] = String(q.data ?? '').split('|');\n// Nome do ícone: 1ª linha da legenda da foto (\"Iconlibrary — nome\")\nconst legenda = (msg.reply_to_message ?? msg).caption ?? '';\nconst nome = (legenda.split('\\n')[0].split(' — ').pop() || 'ícone #' + id).trim();\nconst MOTIVOS = {\n  marca: 'Logotipo ou marca registrada',\n  ofensivo: 'Conteúdo ofensivo',\n  nome: 'O nome não corresponde ao desenho',\n  qualidade: 'Qualidade ou desenho incompleto',\n  outro: 'Recusado na moderação',\n};\nconst comum = { ...base, id, t, nome, submittedAt: Number(t) * 1000 };\nif (acao === 'r') return [{ json: { ...comum, passo: 'motivos', aviso: 'Escolha o motivo' } }];\nif (acao === 'd') return [{ json: { ...comum, passo: 'confirmar', aviso: 'Confirme a exclusão' } }];\nif (acao === 'c') return [{ json: { ...comum, passo: 'cancelar', aviso: 'Cancelado' } }];\nconst decisao = { a: 'approve', m: 'reject', x: 'delete' }[acao];\nif (!decisao || !/^\\d+$/.test(id ?? '')) return [{ json: { ...base, passo: 'negado', aviso: 'Botão inválido.' } }];\nreturn [{\n  json: {\n    ...comum,\n    passo: 'decidir',\n    acao: decisao,\n    nota: decisao === 'reject' ? 'Telegram: ' + (MOTIVOS[k] ?? MOTIVOS.outro) : undefined,\n    aviso: 'Enviando…',\n  },\n}];\n"
      }
    },
