{
  "name": "Icon Library — moderação de avaliações (Telegram)",
  "nodes": [
    {
      "id": "76b83fa1-190c-431b-a333-a78c2991b1b1",
      "name": "Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
