# =============================================================================
# ICON-LIBRARY — variáveis da stack no Portainer
#
# 1. Copie este arquivo para stack.env (que o git ignora) e preencha.
# 2. No Portainer, na stack: Environment variables → "Load variables from
#    .env file" → escolha o stack.env.
# 3. O compose recebe tudo com:   env_file:
#                                   - stack.env
#
# Formato: NOME=valor, sem aspas e sem espaços em volta do "=".
# Evite "$" nos valores (o Compose o interpreta).
# =============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# Container na internal_network: o nome do container (ex.: postgres).
# PostgreSQL direto no servidor, fora do Docker: host.docker.internal
PG_HOST=
PG_PORT=5432
PG_DATABASE=iconlibrary
# Usuário da aplicação: só lê e grava. As migrations ficam com o
# iconlibrary_owr (npm run migrate), por isso PG_MIGRATE=false.
PG_USER=iconlibrary_api
PG_PASSWORD=
PG_MIGRATE=false
# true se o PostgreSQL exigir SSL
PG_SSL=false

# ── Pague um café (Stripe) ───────────────────────────────────────────────────
# Chave restrita com a permissão "Checkout Sessions: Read".
# Comece com a de teste (rk_test_…) e troque pela real (rk_live_…) depois.
STRIPE_SECRET_KEY=
# Link do Payment Link (US$ 3). Nas opções do link, "Após o pagamento" →
# redirecionar para: https://iconlibrary.io/?coffee={CHECKOUT_SESSION_ID}
STRIPE_PAYMENT_LINK=
# Opcional: só pagamentos deste link contam (plink_…)
STRIPE_PAYMENT_LINK_ID=
# O preço mostrado no botão é "US$ 3" quando esta linha fica comentada.
# Para outro texto, descomente sem usar "$" (ex.: USD 3):
# COFFEE_PRICE=USD 3

# ── Moderação da Iconlibrary (/admin) ────────────────────────────────────────
# Senha longa; o nome de usuário pedido pelo navegador pode ser qualquer um.
ADMIN_PASSWORD=
